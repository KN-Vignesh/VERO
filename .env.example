# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Optional GitHub personal access token to raise public API rate limit from 60/hr to 5,000/hr.
GITHUB_TOKEN=""

# TYPESAFE_API_KEY: Optional TypeSafe Jev API key for live cloud Jev model inference.
TYPESAFE_API_KEY=""

# SONARQUBE_URL: Optional SonarQube / SonarCloud server instance URL.
SONARQUBE_URL=""
SONARQUBE_TOKEN=""

# VITE_API_BASE_URL: Optional remote backend URL when deploying frontend to static hosting (e.g., GitHub Pages / is-a.dev).
# Leave empty to use same-origin /api or automatic browser-side pipeline execution on static hosts.
VITE_API_BASE_URL=""

